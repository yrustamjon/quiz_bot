# Generate: python -c 'import secrets; print(secrets.token_urlsafe(48))'
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Leave DATABASE_URL unset for backend/db.sqlite3
# DATABASE_URL=postgresql://user:password@localhost:5432/quiz_bot
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
TELEGRAM_BOT_TOKEN=
PUBLIC_BASE_URL=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional private media directory override; default backend/media
# MEDIA_ROOT=/absolute/private/path

# Dedicated cache DB; bot/broker use DB 0 and results use DB 1
REDIS_CACHE_URL=redis://127.0.0.1:6379/2
